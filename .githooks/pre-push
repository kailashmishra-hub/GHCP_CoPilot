#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$repo_root"

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$repo_root/.githooks/pre-push.ps1" "$@"
elif command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$repo_root/.githooks/pre-push.ps1" "$@"
else
  echo "PowerShell is required for the impact-tracker pre-push hook." >&2
  exit 1
fi
